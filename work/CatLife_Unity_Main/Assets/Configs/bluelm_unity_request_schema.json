{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catlife.local/schemas/bluelm_unity_request_schema.json",
  "title": "CatLife BlueLM Unity Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "createdAtUtcTicks",
    "timeoutMs",
    "systemPrompt",
    "developerPrompt",
    "userContextJson",
    "outputSchemaJson"
  ],
  "properties": {
    "schemaVersion": { "const": "catlife.bluelm.request.v1" },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{32}$"
    },
    "createdAtUtcTicks": { "type": "integer", "minimum": 1 },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "systemPrompt": {
      "type": "string",
      "maxLength": 4000,
      "not": { "pattern": "(rawText|packageName|clipboard|screenContent)" }
    },
    "developerPrompt": {
      "type": "string",
      "maxLength": 4000,
      "not": { "pattern": "(rawText|packageName|clipboard|screenContent)" }
    },
    "userContextJson": {
      "type": "string",
      "maxLength": 8000,
      "not": { "pattern": "(rawText|packageName|clipboard|screenContent|\\\"x\\\"|\\\"y\\\")" }
    },
    "outputSchemaJson": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
